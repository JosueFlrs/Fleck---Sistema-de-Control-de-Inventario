# =========================================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example) - INVENTARIO ITU
# Instrucciones: Copia este archivo en la raíz del proyecto, renombralo
# exactamente como ".env" y completa los valores según tu entorno local.
# =========================================================================

# --- CONFIGURACIÓN DE NÚCLEO (FLASK) ---
# Clave aleatoria y segura para cifrar las cookies de sesión y mensajes flash.
# Ejemplo en desarrollo: mi-clave-secreta-local
SECRET_KEY=

# --- CONFIGURACIÓN DE SQL SERVER ---
# Host/IP del servidor de base de datos (Ej: localhost, 127.0.0.1 o la IP del contenedor)
SQL_HOST=
# Puerto por defecto de SQL Server (Normalmente es 1433)
SQL_PORT=1433
# Usuario administrador o con permisos de lectura/escritura (Ej: sa)
SQL_USER=
# Contraseña del usuario configurado arriba
SQL_PASSWORD=
# Nombre de la base de datos relacional
SQL_DATABASE=

# --- CONFIGURACIÓN DE MONGODB (Especificaciones de Hardware) ---
# Host/IP del servidor NoSQL (Ej: localhost o el nombre del servicio en Docker)
MONGO_HOST=
# Puerto por defecto de MongoDB (Normalmente es 27017)
MONGO_PORT=27017
# Nombre de la base de datos NoSQL
MONGO_DB=
# Nombre de la colección dentro de la base de datos (Ej: hardware)
MONGO_COLLECTION=
# Usuario de MongoDB (Dejar vacío si no configuraste autenticación local)
MONGO_USER=
# Contraseña de MongoDB (Dejar vacío si no configuraste autenticación local)
MONGO_PASSWORD=

# --- CONFIGURACIÓN DE LDAP / ACTIVE DIRECTORY (Autenticación) ---
# Servidor encargado de gestionar el directorio de usuarios (IP o Dominio)
LDAP_HOST=
# Puerto por defecto del servicio LDAP (Normalmente 389 para conexiones estándar)
LDAP_PORT=389
# Dominio de la red institucional utilizado para el inicio de sesión (Ej: itu.local)
LDAP_DOMAIN=